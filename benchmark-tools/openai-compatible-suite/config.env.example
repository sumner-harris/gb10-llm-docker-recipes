# URL before /v1. This may be a remote vLLM host.
BASE_URL=http://127.0.0.1:8000
API_KEY=EMPTY

# Leave empty only when /v1/models advertises exactly one model.
MODEL_ID=

# Capability scoring is one deterministic pass, not a concurrency sweep.
# This only controls how many independent examples lm-eval submits at once.
EVAL_CONCURRENCY=4
# Capability models can legitimately reason for more than one hour on a single
# 65K-budget example. Keep this at three hours to avoid client-side truncation.
EVAL_TIMEOUT=10800
EVAL_TASKS="aime25 ifeval"
MAX_GEN_TOKS=65536

# GPQA Diamond is attempted separately because its official dataset is gated.
# auto: run when Hugging Face auth and dataset access are available, otherwise
# record BLOCKED and continue. Use 0 to disable the access check and stage.
RUN_GPQA=auto
GPQA_TASK=gpqa_diamond_cot_zeroshot

# Fixed-output throughput matrix.
PERF_REQUESTS=24
PERF_CONCURRENCIES=1,4,8
# Kept separate from EVAL_TIMEOUT so capability timeout changes do not alter
# the fixed-output performance workload.
PERF_TIMEOUT=3600
RESULTS_DIR=results
